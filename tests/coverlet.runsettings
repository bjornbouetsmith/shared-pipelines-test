<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <!-- Feeds Sonar the OpenCover report it understands. Collection is
       configured here rather than on the command line because the
       "dotnet test" collector option needs an argument containing a space. -->
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>opencover</Format>
          <Include>[SharedPipelines.Sample]*</Include>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
